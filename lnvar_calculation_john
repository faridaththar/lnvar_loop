# to calculate expected weight

# pheno dataset, later, will also be used for aerated and non-aerated analysis
pheno_lm <- pheno # to subset the dataset, only for calculation of lm for overall dataset

# merge the output of regression the transformed weight using growth exponent of 1.77 with fish age with pheno data set
# fit_lm - including intercept and slope
pheno_lm <- merge(pheno_lm,fit_lm, by.x = "id",by.y = "id", all.x = TRUE, all.y = TRUE)
summary(pheno_lm)
pheno_lm$intercept_lm <- as.numeric(pheno_lm$intercept_lm)
pheno_lm$slope_lm <- as.numeric(pheno_lm$slope_lm)

# Expected weight (y = intercept + slope * time)
pheno_lm$xWT1_root <- pheno_lm$intercept_lm+(pheno_lm$slope_lm*pheno_lm$age1) #expected value value for T1
pheno_lm$xWT2_root <- pheno_lm$intercept_lm+(pheno_lm$slope_lm*pheno_lm$age2) #expected value value for T2
pheno_lm$xWT3_root <- pheno_lm$intercept_lm+(pheno_lm$slope_lm*pheno_lm$age3) #expected value value for T3
pheno_lm$xWT4_root <- pheno_lm$intercept_lm+(pheno_lm$slope_lm*pheno_lm$age4) #expected value value for T4
pheno_lm$xWT5_root <- pheno_lm$intercept_lm+(pheno_lm$slope_lm*pheno_lm$age5) #expected value value for T5

# to calculate the deviation from expected weight
pheno_lm$dev_root1 <- pheno_lm$rootWT1 - pheno_lm$xWT1_root
pheno_lm$dev_root2 <- pheno_lm$rootWT2 - pheno_lm$xWT2_root
pheno_lm$dev_root3 <- pheno_lm$rootWT3 - pheno_lm$xWT3_root
pheno_lm$dev_root4 <- pheno_lm$rootWT4 - pheno_lm$xWT4_root
pheno_lm$dev_root5 <- pheno_lm$rootWT5 - pheno_lm$xWT5_root

