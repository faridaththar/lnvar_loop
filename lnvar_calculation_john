##### lm to estimate of a and b with f=1.77 ####regression w1/1.77 with age
data_lm <- pheno
data_lm <- pheno[,c(1,8:12,16:20)]
data_lm <- data.frame(time = as.numeric(c(pheno$age1 , pheno$age2 , pheno$age3 , pheno$age4 , pheno$age5)) ,
                      y = as.numeric(c(pheno$rootWT1 , pheno$rootWT2 , pheno$rootWT3 , pheno$rootWT4 , pheno$rootWT5)) ,
                      fish = as.factor(c(pheno$id,pheno$id,pheno$id,pheno$id,pheno$id))) 

# Fit the linear model
fit_lm <- data.frame(id = numeric(),
                     Intercept = numeric(),
                     Slope = numeric())

# Loop through unique id, fit linear models, and store results
unique_fishids <- unique(data_lm$fish)
for (fishid in unique_fishids) {
  subset_data <- subset(data_lm, fish == fishid)
  model <- lm(y ~ time, data = subset_data)
  fit_lm <- rbind(fit_lm, c(fishid, coef(model)))
}

colnames(fit_lm) <- c("id", "intercept_lm", "slope_lm")
head (fit_lm)

write.csv(fit_lm, 
          file = "C:/Users/farid_3pysgpv/OneDrive/Paper_3/Paper_3/submission_scientific_reports/R/output_fit_lm.csv",
