length_data <- read.table("data_May10-2019.csv", header = T, sep = ",", stringsAsFactors = F, na.strings = "*")
length_data <- length_data[, c(1,26,38,50,62,74,21:23,25)] #select column id, WT1-5, pond, sex, hapa, new id,
length_data <- length_data[,c("tag","L1","L2","L3","L4","L5","pond")]
length_data <- length_data[!is.na(apply(length_data[,2:6],1,sum)),]
head(length_data)

stocking_age <- 71 ## 16 days of mating/2 + 60 days nursery + 3 days conditioning before tagging+stocking)

length_data$age1[length_data$pond %in% 18] <- 1 + stocking_age
length_data$age1[length_data$pond %in% 17] <- 1 + stocking_age
length_data$age2[length_data$pond %in% 18] <- 55 + stocking_age
length_data$age2[length_data$pond %in% 17] <- 56 + stocking_age
length_data$age3[length_data$pond %in% 18] <- 104 + stocking_age
length_data$age3[length_data$pond %in% 17] <- 105 + stocking_age
length_data$age4[length_data$pond %in% 18] <- 167 + stocking_age
length_data$age4[length_data$pond %in% 17] <- 168 + stocking_age
length_data$age5[length_data$pond %in% 18] <- 217 + stocking_age
length_data$age5[length_data$pond %in% 17] <- 218 + stocking_age

length_data2 <- length_data
length_data2 <- data.frame(time = as.numeric(c(length_data2$age1 , length_data2$age2 , length_data2$age3 , length_data2$age4 , length_data2$age5)) ,
                y = as.numeric(c(length_data2$L1 , length_data2$L2 , length_data2$L3 , length_data2$L4 , length_data2$L5)) ,
                fish = as.factor(c(length_data2$tag,length_data2$tag,length_data2$tag,length_data2$tag,length_data2$tag)),
                pond = as.factor(c(length_data2$pond,length_data2$pond,length_data2$pond,length_data2$pond,length_data2$pond))) #to include pond in the dataframe d

#To check the significance
# fish id for looping
#unique_fish_ids <- unique(df$fish_id)
fish_id <- unique(length_data2$fish)

# Create an empty list to store the results
results_list <- list()

# Loop through each fish ID
for (fish in fish_id) {
  # Subset the data for the current fish
  fish_data <- subset(length_data2, fish == fish)
  
  # Fit the linear regression model
  model_linear <- lm(y ~ time, data = fish_data)
  
  # Fit the quadratic regression model
  model_quadratic <- lm(y ~ time + I(time^2), data = fish_data)
  
  # Compare the two models using an ANOVA test
  anova_result <- anova(model_linear, model_quadratic)
  
  # Store the results in the list
  results_list[[paste0("Fish_", tag)]] <- list(
    linear_model = summary(model_linear),
    quadratic_model = summary(model_quadratic),
    anova_result = anova_result
  )
}

# Print or inspect the results
print(results_list)


